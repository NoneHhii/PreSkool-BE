// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String

  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile      UserProfile?
  student      Student?
  teacher      Teacher?

  refreshTokens RefreshToken[]

  @@index([role])
  @@index([status])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique

  fullName    String
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  address     String?
  avatarUrl   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Student {
  id             String   @id @default(uuid())
  userId         String   @unique

  studentCode    String   @unique

  enrollmentDate DateTime?
  status         String   @default("ACTIVE")
  
  cohort         String?
  majorId        String?
  major          Major?   @relation(fields: [majorId], references: [id])
  
  homeroomClassId String?
  homeroomClass   HomeroomClass? @relation(fields: [homeroomClassId], references: [id])

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  classes        ClassStudent[]
  attendances    Attendance[]
}

model Teacher {
  id             String   @id @default(uuid())
  userId         String   @unique

  teacherCode    String   @unique
  specialization String?

  hireDate       DateTime?
  status         String   @default("ACTIVE")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  classes        Class[]
  homeroomClasses HomeroomClass[]
}

model RefreshToken {
  id        String   @id @default(uuid())

  tokenHash String   @unique

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Faculty {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  
  majors      Major[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Major {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  facultyId   String
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  
  students    Student[]
  homeroomClasses HomeroomClass[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  credits     Int
  description String?
  
  prerequisites Course[] @relation("CoursePrerequisites")
  prerequisiteFor Course[] @relation("CoursePrerequisites")

  classes     Class[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Class {
  id          String   @id @default(uuid())
  code        String   @unique
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id])
  
  academicYear String  
  semester     Int     
  
  students    ClassStudent[]
  schedules   Schedule[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClassStudent {
  id          String   @id @default(uuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  
  enrolledAt  DateTime @default(now())
  
  @@unique([classId, studentId])
}

model Schedule {
  id          String   @id @default(uuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  
  date        DateTime @db.Date 
  shift       String   
  room        String
  
  attendances Attendance[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

model Attendance {
  id          String   @id @default(uuid())
  scheduleId  String
  schedule    Schedule @relation(fields: [scheduleId], references: [id])
  
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  
  status      AttendanceStatus
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([scheduleId, studentId])
}

model HomeroomClass {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  majorId     String
  major       Major    @relation(fields: [majorId], references: [id])
  cohort      String   
  advisorId   String?  
  advisor     Teacher? @relation(fields: [advisorId], references: [id])
  
  students    Student[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}